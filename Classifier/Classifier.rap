nt" xmlns:b="http://www.w3.org/2001/XMLSchema">17</_version><_line0 i:type="b:string" xmlns:b="http://www.w3.org/2001/XMLSchema">FINAL PROJECT - Click-and-train classifier (a perceptron)</_line0><_line1 i:type="b:string" xmlns:b="http://www.w3.org/2001/XMLSchema">1) choose RED or BLUE and click to add training points</_line1><_line2 i:type="b:string" xmlns:b="http://www.w3.org/2001/XMLSchema">2) press TRAIN: the perceptron learns a line that separates the colours</_line2><_line3 i:type="b:string" xmlns:b="http://www.w3.org/2001/XMLSchema">3) choose TEST and click anywhere: the model predicts the colour</_line3></_comment><_created_guid i:type="b:guid" xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/">b5d80e11-4e8b-439f-a52e-3a769dafdb8c</_created_guid><_changed_guid i:type="b:guid" xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/">b5d80e11-4e8b-439f-a52e-3a769dafdb8c</_changed_guid><_kind i:type="a:Rectangle.Kind_Of">Call</_kind></_Successor><_is_child i:type="b:boolean" xmlns="" xmlns:b="http://www.w3.org/2001/XMLSchema">false</_is_child><_is_beforeChild i:type="b:boolean" xmlns="" xmlns:b="http://www.w3.org/2001/XMLSchema">false</_is_beforeChild><_is_afterChild i:type="b:boolean" xmlns="" xmlns:b="http://www.w3.org/2001/XMLSchema">false</_is_afterChild><_full_text i:type="b:boolean" xmlns="" xmlns:b="http://www.w3.org/2001/XMLSchema">true</_full_text><_height_of_text i:type="b:int" xmlns="" xmlns:b="http://www.w3.org/2001/XMLSchema">14</_height_of_text><_char_length i:type="b:int" xmlns="" xmlns:b="http://www.w3.org/2001/XMLSchema">0</_char_length><_comment i:nil="true" xmlns=""/><_created_guid i:type="b:guid" xmlns="" xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/">526cadb9-9630-40be-a46f-becd3ec04845</_created_guid><_changed_guid i:type="b:guid" xmlns="" xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/">526cadb9-9630-40be-a46f-becd3ec04845</_changed_guid></a:Start><a:Text>main</a:Text><a:kind>Subchart</a:kind></a