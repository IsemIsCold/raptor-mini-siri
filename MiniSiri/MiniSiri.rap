:b="http://www.w3.org/2001/XMLSchema">-10</_y_location><_version i:type="b:int" xmlns:b="http://www.w3.org/2001/XMLSchema">1</_version><_line0 i:type="b:string" xmlns:b="http://www.w3.org/2001/XMLSchema">THE TRAINING DATA</_line0><_line1 i:type="b:string" xmlns:b="http://www.w3.org/2001/XMLSchema">Every known word is stored with the intent it belongs to:</_line1><_line2 i:type="b:string" xmlns:b="http://www.w3.org/2001/XMLSchema">tw[j] = word, tint[j] = intent number.</_line2><_line3 i:type="b:string" xmlns:b="http://www.w3.org/2001/XMLSchema">Words are sorted by first letter; bstart[b]..bend[b] is the block of</_line3><_line4 i:type="b:string" xmlns:b="http://www.w3.org/2001/XMLSchema">words starting with letter b (a=1 ... z=26, symbols=27), so a word is only</_line4><_line5 i:type="b:string" xmlns:b="http://www.w3.org/2001/XMLSchema">compared with the few words that start with the same letter.</_line5></_comment><_created_guid i:type="b:guid" xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/">1028bec0-975e-4108-88bf-dd1d70cf7711</_created_guid><_changed_guid i:type="b:guid" xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/">1028bec0-975e-4108-88bf-dd1d70cf7711</_changed_guid><_kind i:type="a:Rectangle.Kind_Of">Assignment</_kind></_Successor><_is_child i:type="b:boolean" xmlns="" xmlns:b="http://www.w3.org/2001/XMLSchema">false</_is_child><_is_beforeChild i:type="b:boolean" xmlns="" xmlns:b="http://www.w3.org/2001/XMLSchema">false</_is_beforeChild><_is_afterChild i:type="b:boolean" xmlns="" xmlns:b="http://www.w3.org/2001/XMLSchema">false</_is_afterChild><_full_text i:type="b:boolean" xmlns="" xmlns:b="http://www.w3.org/2001/XMLSchema">true</_full_text><_height_of_text i:type="b:int" xmlns="" xmlns:b="http://www.w3.org/2001/XMLSchema">14</_height_of_text><_char_length i:type="b:int" xmlns="" xmlns:b="http://www.w3.org/2001/XMLSchema">0</_char_length><_comment i:nil="true" xmlns=""/><_created_guid i:type="b:guid" xmlns="" xmlns:b="http://schema