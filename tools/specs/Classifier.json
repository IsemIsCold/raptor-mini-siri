{
 "subcharts": [
  {
   "name": "main",
   "body": [
    {
     "call": "Open_Graph_Window(600, 500)",
     "comment": "FINAL PROJECT - Click-and-train classifier (a perceptron)\n1) choose RED or BLUE and click to add training points\n2) press TRAIN: the perceptron learns a line that separates the colours\n3) choose TEST and click anywhere: the model predicts the colour"
    },
    {
     "call": "Set_Window_Title(\"Perceptron classifier - click to teach, TRAIN to learn\")"
    },
    {
     "assign": "mx",
     "value": "0",
     "comment": "Create every variable first (avoids RAPTOR 'not found' errors)"
    },
    {
     "assign": "my",
     "value": "0"
    },
    {
     "assign": "btn",
     "value": "0"
    },
    {
     "assign": "pen",
     "value": "0"
    },
    {
     "assign": "done",
     "value": "0"
    },
    {
     "assign": "npts",
     "value": "0"
    },
    {
     "assign": "ntest",
     "value": "0"
    },
    {
     "assign": "w0",
     "value": "0"
    },
    {
     "assign": "w1",
     "value": "0"
    },
    {
     "assign": "w2",
     "value": "0"
    },
    {
     "assign": "lr",
     "value": "0"
    },
    {
     "assign": "trained",
     "value": "0"
    },
    {
     "assign": "epoch",
     "value": "0"
    },
    {
     "assign": "errors",
     "value": "0"
    },
    {
     "assign": "i",
     "value": "0"
    },
    {
     "assign": "u",
     "value": "0"
    },
    {
     "assign": "v",
     "value": "0"
    },
    {
     "assign": "s",
     "value": "0"
    },
    {
     "assign": "pred",
     "value": "0"
    },
    {
     "assign": "selx",
     "value": "0"
    },
    {
     "assign": "ya",
     "value": "0"
    },
    {
     "assign": "yb",
     "value": "0"
    },
    {
     "assign": "xa",
     "value": "0"
    },
    {
     "assign": "correct",
     "value": "0"
    },
    {
     "assign": "px[1]",
     "value": "0",
     "comment": "Training data: px[i], py[i] = position, lab[i] = +1 (RED) or -1 (BLUE)"
    },
    {
     "assign": "py[1]",
     "value": "0"
    },
    {
     "assign": "lab[1]",
     "value": "0"
    },
    {
     "assign": "tx[1]",
     "value": "0",
     "comment": "Test points: tx[j], ty[j] = position, tl[j] = predicted class"
    },
    {
     "assign": "ty[1]",
     "value": "0"
    },
    {
     "assign": "tl[1]",
     "value": "0"
    },
    {
     "assign": "pen",
     "value": "1",
     "comment": "pen = what a click adds: 1 = RED point, -1 = BLUE point, 0 = TEST"
    },
    {
     "assign": "lr",
     "value": "0.2",
     "comment": "learning rate: how far the line moves after each mistake"
    },
    {
     "assign": "msg",
     "value": "\"Choose RED or BLUE, then click in the white area to add points\""
    },
    {
     "call": "Redraw"
    },
    {
     "repeat": [
      {
       "call": "Get_Mouse_Button(Left_Button, mx, my)",
       "comment": "wait for a left click"
      },
      {
       "if": "my < 90",
       "then": [
        {
         "assign": "btn",
         "value": "floor(mx / 100) + 1",
         "comment": "6 buttons, each 100 pixels wide"
        },
        {
         "if": "btn = 1",
         "then": [
          {
           "assign": "pen",
           "value": "1"
          },
          {
           "assign": "msg",
           "value": "\"RED: click to add red points\""
          }
         ],
         "else": [
          {
           "if": "btn = 2",
           "then": [
            {
             "assign": "pen",
             "value": "-1"
            },
            {
             "assign": "msg",
             "value": "\"BLUE: click to add blue points\""
            }
           ],
           "else": [
            {
             "if": "btn = 3",
             "then": [
              {
               "assign": "pen",
               "value": "0"
              },
              {
               "if": "trained = 1",
               "then": [
                {
                 "assign": "msg",
                 "value": "\"TEST: click anywhere, the model predicts the colour\""
                }
               ],
               "else": [
                {
                 "assign": "msg",
                 "value": "\"Press TRAIN first, then TEST\""
                }
               ]
              }
             ],
             "else": [
              {
               "if": "btn = 4",
               "then": [
                {
                 "call": "Train"
                }
               ],
               "else": [
                {
                 "if": "btn = 5",
                 "then": [
                  {
                   "assign": "npts",
                   "value": "0"
                  },
                  {
                   "assign": "ntest",
                   "value": "0"
                  },
                  {
                   "assign": "w0",
                   "value": "0"
                  },
                  {
                   "assign": "w1",
                   "value": "0"
                  },
                  {
                   "assign": "w2",
                   "value": "0"
                  },
                  {
                   "assign": "trained",
                   "value": "0"
                  },
                  {
                   "assign": "epoch",
                   "value": "0"
                  },
                  {
                   "assign": "pen",
                   "value": "1"
                  },
                  {
                   "assign": "msg",
                   "value": "\"Cleared. Choose RED or BLUE and add new points\""
                  }
                 ],
                 "else": [
                  {
                   "assign": "done",
                   "value": "1"
                  }
                 ]
                }
               ]
              }
             ]
            }
           ]
          }
         ]
        }
       ],
       "else": [
        {
         "if": "my > 100 and my < 470",
         "then": [
          {
           "if": "pen != 0",
           "then": [
            {
             "assign": "npts",
             "value": "npts + 1",
             "comment": "add a training point"
            },
            {
             "assign": "px[npts]",
             "value": "mx"
            },
            {
             "assign": "py[npts]",
             "value": "my"
            },
            {
             "assign": "lab[npts]",
             "value": "pen"
            },
            {
             "assign": "msg",
             "value": "\"Training points: \" + npts + \"   (press TRAIN when ready)\""
            }
           ],
           "else": [
            {
             "if": "trained = 1",
             "then": [
              {
               "assign": "u",
               "value": "mx / 600",
               "comment": "same feature scaling as in training"
              },
              {
               "assign": "v",
               "value": "(my - 100) / 370"
              },
              {
               "assign": "s",
               "value": "w0 + w1 * u + w2 * v",
               "comment": "score > = 0 means RED, < 0 means BLUE"
              },
              {
               "if": "s >= 0",
               "then": [
                {
                 "assign": "pred",
                 "value": "1"
                },
                {
                 "assign": "msg",
                 "value": "\"Prediction: RED\""
                }
               ],
               "else": [
                {
                 "assign": "pred",
                 "value": "-1"
                },
                {
                 "assign": "msg",
                 "value": "\"Prediction: BLUE\""
                }
               ]
              },
              {
               "assign": "ntest",
               "value": "ntest + 1"
              },
              {
               "assign": "tx[ntest]",
               "value": "mx"
              },
              {
               "assign": "ty[ntest]",
               "value": "my"
              },
              {
               "assign": "tl[ntest]",
               "value": "pred"
              }
             ],
             "else": [
              {
               "assign": "msg",
               "value": "\"Press TRAIN first, then TEST\""
              }
             ]
            }
           ]
          }
         ]
        }
       ]
      },
      {
       "if": "done = 0",
       "then": [
        {
         "call": "Redraw"
        }
       ]
      }
     ],
     "until": "done = 1"
    },
    {
     "call": "Close_Graph_Window"
    }
   ]
  },
  {
   "name": "Train",
   "body": [
    {
     "if": "npts < 2",
     "then": [
      {
       "assign": "msg",
       "value": "\"Add at least 2 points (both colours) before training\""
      },
      {
       "call": "Redraw"
      }
     ],
     "else": [
      {
       "assign": "epoch",
       "value": "0",
       "comment": "Perceptron learning rule:\nfor every point the model gets wrong,\nmove the weights toward the right answer"
      },
      {
       "assign": "errors",
       "value": "1"
      },
      {
       "while": "errors > 0 and epoch < 100",
       "body": [
        {
         "assign": "epoch",
         "value": "epoch + 1",
         "comment": "one epoch = one pass over all training points"
        },
        {
         "assign": "errors",
         "value": "0"
        },
        {
         "for": "i",
         "from": "1",
         "to": "npts",
         "body": [
          {
           "assign": "u",
           "value": "px[i] / 600",
           "comment": "scale x to 0..1"
          },
          {
           "assign": "v",
           "value": "(py[i] - 100) / 370",
           "comment": "scale y to 0..1"
          },
          {
           "assign": "s",
           "value": "w0 + w1 * u + w2 * v",
           "comment": "score = bias + w1*u + w2*v"
          },
          {
           "if": "s >= 0",
           "then": [
            {
             "assign": "pred",
             "value": "1"
            }
           ],
           "else": [
            {
             "assign": "pred",
             "value": "-1"
            }
           ]
          },
          {
           "if": "pred != lab[i]",
           "then": [
            {
             "assign": "errors",
             "value": "errors + 1",
             "comment": "wrong: nudge the weights toward the correct class"
            },
            {
             "assign": "w0",
             "value": "w0 + lr * lab[i]"
            },
            {
             "assign": "w1",
             "value": "w1 + lr * lab[i] * u"
            },
            {
             "assign": "w2",
             "value": "w2 + lr * lab[i] * v"
            }
           ]
          }
         ]
        },
        {
         "assign": "msg",
         "value": "\"Training...  epoch \" + epoch + \"   mistakes: \" + errors"
        },
        {
         "call": "Redraw",
         "comment": "show the line moving after every epoch"
        }
       ]
      },
      {
       "assign": "trained",
       "value": "1"
      },
      {
       "assign": "correct",
       "value": "npts - errors"
      },
      {
       "if": "errors = 0",
       "then": [
        {
         "assign": "msg",
         "value": "\"Learned! All \" + npts + \" points correct after \" + epoch + \" epochs. Try TEST\""
        }
       ],
       "else": [
        {
         "assign": "msg",
         "value": "\"Stopped after 100 epochs: \" + correct + \"/\" + npts + \" correct (no straight line fits)\""
        }
       ]
      },
      {
       "call": "Redraw"
      }
     ]
    }
   ]
  },
  {
   "name": "Redraw",
   "body": [
    {
     "call": "Clear_Window(White)",
     "comment": "Redraw the whole screen"
    },
    {
     "for": "i",
     "from": "1",
     "to": "ntest",
     "body": [
      {
       "if": "tl[i] = 1",
       "then": [
        {
         "call": "Draw_Circle(tx[i], ty[i], 9, Light_Red, Filled)"
        }
       ],
       "else": [
        {
         "call": "Draw_Circle(tx[i], ty[i], 9, Light_Blue, Filled)"
        }
       ]
      },
      {
       "call": "Draw_Circle(tx[i], ty[i], 9, Black, Unfilled)",
       "comment": "test point: ringed, coloured by the prediction"
      }
     ]
    },
    {
     "for": "i",
     "from": "1",
     "to": "npts",
     "body": [
      {
       "if": "lab[i] = 1",
       "then": [
        {
         "call": "Draw_Circle(px[i], py[i], 6, Red, Filled)"
        }
       ],
       "else": [
        {
         "call": "Draw_Circle(px[i], py[i], 6, Blue, Filled)"
        }
       ]
      }
     ]
    },
    {
     "if": "epoch > 0",
     "then": [
      {
       "call": "DrawLine"
      }
     ]
    },
    {
     "call": "Draw_Box(0, 0, 600, 95, White, Filled)",
     "comment": "cover the line outside the plot area"
    },
    {
     "call": "Draw_Box(0, 472, 600, 500, White, Filled)"
    },
    {
     "call": "Draw_Line(0, 97, 600, 97, Black)"
    },
    {
     "call": "Display_Text(10, 492, msg, Black)"
    },
    {
     "call": "Draw_Box(8, 15, 92, 80, Red, Filled)"
    },
    {
     "call": "Display_Text(38, 55, \"RED\", White)"
    },
    {
     "call": "Draw_Box(108, 15, 192, 80, Blue, Filled)"
    },
    {
     "call": "Display_Text(134, 55, \"BLUE\", White)"
    },
    {
     "call": "Draw_Box(208, 15, 292, 80, Dark_Gray, Filled)"
    },
    {
     "call": "Display_Text(234, 55, \"TEST\", White)"
    },
    {
     "call": "Draw_Box(308, 15, 392, 80, Green, Filled)"
    },
    {
     "call": "Display_Text(330, 55, \"TRAIN\", White)"
    },
    {
     "call": "Draw_Box(408, 15, 492, 80, Brown, Filled)"
    },
    {
     "call": "Display_Text(430, 55, \"RESET\", White)"
    },
    {
     "call": "Draw_Box(508, 15, 592, 80, Black, Filled)"
    },
    {
     "call": "Display_Text(534, 55, \"QUIT\", White)"
    },
    {
     "if": "pen = 1",
     "then": [
      {
       "assign": "selx",
       "value": "0"
      }
     ],
     "else": [
      {
       "if": "pen = -1",
       "then": [
        {
         "assign": "selx",
         "value": "100"
        }
       ],
       "else": [
        {
         "assign": "selx",
         "value": "200"
        }
       ]
      }
     ]
    },
    {
     "call": "Draw_Box(selx + 3, 10, selx + 97, 85, Black, Unfilled)",
     "comment": "frame around the selected pen"
    }
   ]
  },
  {
   "name": "DrawLine",
   "body": [
    {
     "if": "abs(w2) > 0.0001",
     "then": [
      {
       "assign": "ya",
       "value": "100 + 370 * (0 - w0) / w2",
       "comment": "decision line: w0 + w1*u + w2*v = 0\nsolve for v at u = 0 and u = 1"
      },
      {
       "assign": "yb",
       "value": "100 + 370 * (0 - w0 - w1) / w2"
      },
      {
       "assign": "ya",
       "value": "max(-3000, min(3000, ya))",
       "comment": "keep the numbers drawable"
      },
      {
       "assign": "yb",
       "value": "max(-3000, min(3000, yb))"
      },
      {
       "call": "Draw_Line(0, ya, 600, yb, Black)"
      }
     ],
     "else": [
      {
       "if": "abs(w1) > 0.0001",
       "then": [
        {
         "assign": "xa",
         "value": "600 * (0 - w0) / w1",
         "comment": "vertical line"
        },
        {
         "assign": "xa",
         "value": "max(-3000, min(3000, xa))"
        },
        {
         "call": "Draw_Line(xa, 100, xa, 470, Black)"
        }
       ]
      }
     ]
    }
   ]
  }
 ]
}