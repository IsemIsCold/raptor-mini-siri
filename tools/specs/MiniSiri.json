     "assign": "found",
     "value": "0",
     "comment": "Is the word in 'target' one of the sentence's words?"
    },
    {
     "for": "hk",
     "from": "1",
     "to": "ntok",
     "body": [
      {
       "if": "tok[hk] = target",
       "then": [
        {
         "assign": "found",
         "value": "1"
