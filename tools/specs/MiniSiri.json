   "name": "Teach",
   "body": [
    {
     "call": "Play_Sound(\"siri_teach.wav\")"
    },
    {
     "assign": "newtext",
     "value": "\"Siri: Sorry, I do not know that one yet. Teach me!\"",
     "comment": "LEARNING: unknown sentence -> the user gives the intent,\nand its words are added to the training data"
    },
    {
     "assign": "newwho",
     "value": "2"
    },
    {
     "call": "Say"
    },
    {
     "assign": "newtext",
     "value": "\"      1 goodbye   2 math   3 time   4 date   5 joke\""
    },
    {
     "assign": "newwho",
     "value": "2"
    },
    {
     "call": "Say"
    },
    {
     "assign": "newtext",
     "value": "\"      6 greeting   7 about me   8 how are you   9 thanks   10 coin/dice\""
    },
    {
     "assign": "newwho",
     "value": "2"
    },
    {
     "call": "Say"
    },
    {
     "input": "cat",
     "prompt": "Category number (0 = skip):"
    },
    {
     "if": "cat >= 1 and cat <= nint and cat = floor(cat)",
     "then": [
      {
       "assign": "learned",
       "value": "0"
      },
      {
       "for": "lk",
       "from": "1",
       "to": "ntok",
       "body": [
        {
         "assign": "target",
         "value": "tok[lk]"
        },
        {
         "assign": "stop",
         "value": "0"
        },
        {
         "for": "lj",
         "from": "1",
         "to": "nsw",
         "body": [
          {
           "if": "sw[lj] = target",
           "then": [
            {
             "assign": "stop",
             "value": "1"
            }
           ]
          }
         ]
        },
        {
         "if": "isnum[lk] = 0 and stop = 0",
         "then": [
          {
           "assign": "nlw",
           "value": "nlw + 1",
           "comment": "add the new word to the learned words"
          },
          {
           "assign": "lw[nlw]",
           "value": "target"
          },
          {
           "assign": "lint[nlw]",
           "value": "cat"
          },
          {
           "assign": "learned",
           "value": "learned + 1"
          }
         ]
        }
       ]
      },
      {
       "assign": "newtext",
       "value": "\"Siri: Got it! I learned \" + learned + \" new word(s) for: \" + iname[cat]"
      },
      {
       "assign": "newwho",
       "value": "2"
      },
      {
       "call": "Say"
      },
      {
       "assign": "best",
       "value": "cat"
      },
      {
       "call": "Respond"
      }
     ],
     "else": [
