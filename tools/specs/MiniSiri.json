  {
   "name": "DoMath",
   "body": [
    {
     "assign": "cnt",
     "value": "0",
     "comment": "Find the first two numbers and the operation word"
    },
    {
     "assign": "na",
     "value": "0"
    },
    {
     "assign": "nb",
     "value": "0"
    },
    {
     "assign": "op",
     "value": "0"
    },
    {
     "for": "mk",
     "from": "1",
     "to": "ntok",
     "body": [
      {
       "if": "isnum[mk] = 1",
       "then": [
        {
         "assign": "cnt",
         "value": "cnt + 1"
        },
        {
         "if": "cnt = 1",
         "then": [
          {
           "assign": "na",
           "value": "numval[mk]"
          }
         ],
         "else": [
          {
           "if": "cnt = 2",
           "then": [
            {
             "assign": "nb",
             "value": "numval[mk]"
            }
           ]
          }
         ]
        }
       ],
       "else": [
        {
         "assign": "mt",
         "value": "tok[mk]"
        },
        {
         "if": "mt = \"plus\" or mt = \"add\" or mt = \"sum\" or mt = \"+\"",
         "then": [
          {
           "assign": "op",
           "value": "1"
          }
         ],
         "else": [
          {
           "if": "mt = \"minus\" or mt = \"subtract\" or mt = \"-\"",
           "then": [
            {
             "assign": "op",
             "value": "2"
            }
           ],
           "else": [
            {
             "if": "mt = \"times\" or mt = \"multiply\" or mt = \"multiplied\" or mt = \"x\" or mt = \"*\"",
             "then": [
              {
               "assign": "op",
               "value": "3"
              }
             ],
             "else": [
              {
               "if": "mt = \"divided\" or mt = \"divide\" or mt = \"over\" or mt = \"/\"",
               "then": [
                {
                 "assign": "op",
                 "value": "4"
                }
               ]
              }
             ]
            }
           ]
          }
         ]
        }
       ]
      }
     ]
    },
    {
     "if": "cnt < 2",
     "then": [
      {
       "call": "Play_Sound(\"siri_mathneed.wav\")"
      },
      {
       "assign": "newtext",
       "value": "\"Siri: Give me two whole numbers, for example: what is 12 times 7\""
      },
      {
       "assign": "newwho",
       "value": "2"
      },
      {
       "call": "Say"
      }
     ],
     "else": [
      {
       "if": "op = 0",
       "then": [
        {
         "call": "Play_Sound(\"siri_mathop.wav\")"
        },
        {
         "assign": "newtext",
         "value": "\"Siri: Should I add, subtract, multiply or divide?\""
        },
        {
         "assign": "newwho",
         "value": "2"
        },
        {
         "call": "Say"
        }
       ],
       "else": [
        {
         "if": "op = 1",
         "then": [
          {
           "call": "Play_Sound(\"siri_math.wav\")"
          },
          {
           "assign": "newtext",
           "value": "\"Siri: \" + na + \" + \" + nb + \" = \" + (na + nb)"
          },
          {
           "assign": "newwho",
           "value": "2"
          },
          {
           "call": "Say"
          }
         ],
         "else": [
          {
           "if": "op = 2",
           "then": [
            {
             "call": "Play_Sound(\"siri_math.wav\")"
            },
            {
             "assign": "newtext",
             "value": "\"Siri: \" + na + \" - \" + nb + \" = \" + (na - nb)"
            },
            {
             "assign": "newwho",
             "value": "2"
            },
            {
             "call": "Say"
            }
           ],
           "else": [
            {
             "if": "op = 3",
             "then": [
              {
               "call": "Play_Sound(\"siri_math.wav\")"
              },
              {
               "assign": "newtext",
               "value": "\"Siri: \" + na + \" x \" + nb + \" = \" + (na * nb)"
              },
              {
               "assign": "newwho",
               "value": "2"
              },
              {
               "call": "Say"
              }
             ],
             "else": [
              {
               "if": "nb = 0",
               "then": [
                {
                 "call": "Play_Sound(\"siri_divzero.wav\")"
                },
                {
                 "assign": "newtext",
                 "value": "\"Siri: I cannot divide by zero!\""
                },
                {
                 "assign": "newwho",
                 "value": "2"
                },
                {
                 "call": "Say"
                }
               ],
               "else": [
                {
                 "call": "Play_Sound(\"siri_math.wav\")"
                },
                {
                 "assign": "newtext",
                 "value": "\"Siri: \" + na + \" / \" + nb + \" = \" + (na / nb)"
                },
                {
                 "assign": "newwho",
                 "value": "2"
                },
                {
                 "call": "Say"
                }
               ]
              }
             ]
            }
           ]
          }
         ]
        }
       ]
      }
     ]
    }
   ]
