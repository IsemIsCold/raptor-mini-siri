       "assign": "newtext",
       "value": "\"Siri: OK, never mind.\""
      },
      {
       "assign": "newwho",
       "value": "2"
      },
      {
       "call": "Say"
      }
     ]
    }
   ]
  },
  {
   "name": "Say",
   "body": [
