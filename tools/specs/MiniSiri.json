  {
   "name": "Tokenize",
   "body": [
    {
     "assign": "ntok",
     "value": "0",
     "comment": "Split the sentence into lower-case words.\nLetters and digits build a word; anything else ends it.\n+ - * / become words of their own (for maths)."
    },
    {
     "assign": "cur",
     "value": "\"\""
    },
    {
     "for": "ti",
     "from": "1",
     "to": "length_of(txt)",
     "body": [
      {
       "assign": "code",
       "value": "to_ascii(txt[ti])"
      },
      {
       "if": "code >= 65 and code <= 90",
       "then": [
        {
         "assign": "code",
         "value": "code + 32"
        }
       ],
       "comment": "A..Z -> a..z"
      },
      {
       "if": "(code >= 97 and code <= 122) or (code >= 48 and code <= 57)",
       "then": [
        {
         "assign": "cur",
         "value": "cur + to_character(code)"
        }
       ],
       "else": [
        {
         "call": "PushWord"
        },
        {
         "if": "code = 43 or code = 45 or code = 42 or code = 47",
         "then": [
          {
           "assign": "cur",
           "value": "\"\" + to_character(code)"
          },
          {
           "call": "PushWord"
          }
         ]
        }
       ]
      }
     ]
    },
    {
     "call": "PushWord",
     "comment": "the last word"
    }
   ]
  },
  {
   "name": "PushWord",
   "body": [
    {
     "if": "length_of(cur) > 0",
     "then": [
      {
       "assign": "ntok",
       "value": "ntok + 1"
      },
      {
       "assign": "tok[ntok]",
       "value": "cur"
      },
      {
       "assign": "allnum",
       "value": "1",
       "comment": "is the word a whole number? then keep its value for maths"
      },
      {
       "assign": "val",
       "value": "0"
      },
      {
       "for": "pc",
       "from": "1",
       "to": "length_of(cur)",
       "body": [
        {
         "assign": "dg",
         "value": "to_ascii(cur[pc]) - 48"
        },
        {
         "if": "dg < 0 or dg > 9",
         "then": [
          {
           "assign": "allnum",
           "value": "0"
          }
         ],
         "else": [
          {
           "assign": "val",
           "value": "val * 10 + dg"
          }
         ]
        }
       ]
      },
      {
       "assign": "isnum[ntok]",
       "value": "allnum"
      },
      {
       "assign": "numval[ntok]",
       "value": "val"
      },
      {
       "assign": "cur",
       "value": "\"\""
      }
     ]
    }
   ]
  },
  {
   "name": "Classify",
   "body": [
    {
     "for": "cq",
     "from": "1",
     "to": "nint",
     "body": [
      {
       "assign": "score[cq]",
       "value": "0"
      }
     ],
     "comment": "THE CLASSIFIER (bag of words)\nEach intent gets one point for every word of the\nsentence that appears in its training words.\nThe intent with the most points wins."
    },
    {
     "for": "sk",
     "from": "1",
     "to": "ntok",
     "body": [
      {
       "if": "isnum[sk] = 0",
       "then": [
        {
         "assign": "t",
         "value": "tok[sk]"
        },
        {
         "assign": "c1",
         "value": "to_ascii(t[1])",
         "comment": "first letter -> which block of training words to search"
        },
        {
         "if": "c1 >= 97 and c1 <= 122",
         "then": [
          {
           "assign": "b",
           "value": "c1 - 96"
          }
         ],
         "else": [
          {
           "assign": "b",
           "value": "27"
          }
         ]
        },
        {
         "for": "sj",
         "from": "bstart[b]",
         "to": "bend[b]",
         "body": [
          {
           "if": "t = tw[sj]",
           "then": [
            {
             "assign": "score[tint[sj]]",
             "value": "score[tint[sj]] + 1"
            }
           ]
          }
         ]
        },
        {
         "for": "sj",
         "from": "1",
         "to": "nlw",
         "body": [
          {
           "if": "t = lw[sj]",
           "then": [
            {
             "assign": "score[lint[sj]]",
             "value": "score[lint[sj]] + 1"
            }
           ]
          }
         ],
         "comment": "also check the words learned from the user"
        }
       ]
      }
     ]
    },
    {
     "assign": "best",
     "value": "0"
    },
    {
     "assign": "bestscore",
     "value": "0"
    },
    {
     "for": "cq",
     "from": "1",
     "to": "nint",
     "body": [
      {
       "if": "score[cq] > bestscore",
       "then": [
        {
         "assign": "bestscore",
         "value": "score[cq]"
        },
        {
         "assign": "best",
         "value": "cq"
        }
       ],
       "comment": "ties go to the lower intent number"
      }
     ]
    }
   ]
  },
